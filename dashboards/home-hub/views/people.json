    {
      "type": "grid",
      "column_span": 2,
      "cards": [
        {
          "type": "custom:expander-card",
          "title-card": {
            "type": "heading",
            "heading": "Map",
            "icon": "mdi:map-marker-outline"
          },
          "title-card-clickable": true,
          "icon": "mdi:chevron-down",
          "expanded": true,
          "storage-id": "__P__map",
          "padding": "0",
          "clear": true,
          "grid_options": {
            "columns": "full"
          },
          "cards": [
            {
              "type": "custom:auto-entities",
              "card": {
                "type": "map",
                "default_zoom": 12,
                "hours_to_show": 12,
                "aspect_ratio": "4:3"
              },
              "filter": {
                "include": [
