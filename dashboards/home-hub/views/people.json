                            "grid-template-areas": "\"i n eye st\" \"i l eye st\""
                          },
                          {
                            "grid-template-columns": "[[[ return (states['input_boolean.__P__show_hidden_trackers']||{}).state==='on' ? '40px 1fr 48px auto' : '40px 1fr 0px auto'; ]]]"
                          },
                          {
                            "grid-template-rows": "auto auto"
                          },
                          {
                            "column-gap": "16px"
                          },
                          {
                            "align-items": "center"
                          }
                        ],
                        "card": [
                          {
                            "padding": "8px 24px 8px 16px"
                          },
                          {
                            "min-height": "72px"
                          },
                          {
                            "background": "none"
                          },
                          {
                            "box-shadow": "none"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "border-radius": "0"
                          },
                          {
                            "display": "[[[ const H=(((states['sensor.__P__hidden_items']||{}).attributes||{}).hidden)||{}; const s=(states['input_boolean.__P__show_hidden_trackers']||{}).state==='on'; return ((H['trackers']||[]).includes(entity.entity_id) && !s) ? 'none' : 'block'; ]]]"
                          },
                          {
                            "opacity": "[[[ const H=(((states['sensor.__P__hidden_items']||{}).attributes||{}).hidden)||{}; return (H['trackers']||[]).includes(entity.entity_id) ? '0.38' : '1'; ]]]"
                          }
                        ],
                        "icon": [
                          {
                            "width": "24px"
                          },
                          {
                            "color": "[[[ return entity.state === 'home' ? 'var(--primary-color)' : 'var(--secondary-text-color)'; ]]]"
                          }
                        ],
                        "name": [
                          {
                            "justify-self": "start"
                          },
                          {
                            "text-align": "left"
                          },
                          {
                            "white-space": "normal"
                          },
                          {
                            "font-size": "16px"
